{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zzonote",
  "version": "0.1.0",
  "identifier": "com.zzonote.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Zzonote",
        "width": 1200,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "یادداشت‌های سبک و سریع",
    "longDescription": "Zzonote — اپلیکیشن یادداشت‌برداری سبک با پشتیبانی از Markdown، تگ‌گذاری، و ذخیره‌ی محلی.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}