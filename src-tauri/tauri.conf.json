{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zzonote",
  "version": "1.0.0",
  "identifier": "com.zzonote.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zzonote",
        "width": 1200,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Fast, lightweight notes app",
    "longDescription": "Zzonote — a lightweight note-taking app with block editor, tables, images, sub-pages, and local storage.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}